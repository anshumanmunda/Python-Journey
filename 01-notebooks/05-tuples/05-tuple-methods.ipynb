        }
      ],
      "source": [
        "t = (10, 20, 30, 40, 50, 'Hello', 50, 'goodmoring', 10)\n",
        "\n",
        "t.count(10)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
