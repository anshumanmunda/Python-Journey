    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "#### Dictionary Comprehension with Condition\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "{2: 4, 4: 16, 6: 36, 8: 64, 10: 100}\n"
          ]
        }
      ],
      "source": [
        "d = { k: k ** 2 for k in range(1,11) if k % 2 == 0 }\n",
        "print(d)"
      ]
    }
